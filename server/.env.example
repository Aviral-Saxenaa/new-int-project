# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL — use individual vars (local dev) …
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=chat_app

# …or a single connection string (Render/Neon/managed hosts).
# When set, it overrides the individual PG* vars above.
# DATABASE_URL=postgres://user:pass@host:5432/chat_app
